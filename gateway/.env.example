# ── Database ────────────────────────────────────────────────────────────────
# Dev (SQLite) — default, no changes needed
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db

# Prod (PostgreSQL) — uncomment and fill in
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/promptcaliper

# ── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# ── First-run superadmin ─────────────────────────────────────────────────────
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@yourorg.com
# REQUIRED: Change before first run
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── LLM Provider Keys ────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
OLLAMA_API_BASE=http://localhost:11434

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_BACKEND=memory
# Prod: set to "redis" and configure below
REDIS_URL=redis://localhost:6379/0

# ── LiteLLM Routing ──────────────────────────────────────────────────────────
LITELLM_ROUTING_STRATEGY=least-busy
LITELLM_NUM_RETRIES=2
LITELLM_TIMEOUT=30

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
GATEWAY_PORT=8000

# ── CORS (JSON list) ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
