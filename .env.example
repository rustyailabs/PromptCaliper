# ============================================================
# PromptCaliper AI Gateway — Production Environment Variables
# Copy this to .env and fill in all required values.
# Never commit .env to version control.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=promptcaliper
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=promptcaliper

# ── Gateway ──────────────────────────────────────────────────
# Required: a long random secret (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=changeme_jwt_secret_replace_with_random_32_bytes

# Initial superadmin credentials (used by seed on first boot)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=changeme_admin_password
SUPERADMIN_EMAIL=admin@example.com

# ── Rate limiting ─────────────────────────────────────────────
# "memory" for dev (single process), "redis" for prod (multi-process)
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# ── CORS ─────────────────────────────────────────────────────
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost","https://yourdomain.com"]

# ── LLM Provider API Keys ────────────────────────────────────
# Fill in whichever providers you use. Leave others blank.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_API_BASE=https://yourresource.openai.azure.com/
AZURE_API_VERSION=2024-02-01

# Google Gemini
GEMINI_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Ollama (local)
OLLAMA_API_BASE=http://host.docker.internal:11434

# ── Frontend ─────────────────────────────────────────────────
# Leave blank when nginx proxies /api — the frontend uses relative URLs
VITE_API_BASE_URL=

# ── Optional ─────────────────────────────────────────────────
DOMAIN=yourdomain.com
